{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/configpanel/PluginConfigurationPanel.tsx", "scripts/*.mjs"],
  "project": [
    "src/**/*.{ts,tsx}",
    "tests/**/*.{ts,tsx}",
    "tests/browser/**/*.{ts,tsx}",
    "fixtures/**/*.{ts,tsx}",
    "scripts/**/*.mjs",
    "*.{ts,js,cjs,mjs}"
  ],
  // The CI Signal K Admin job installs these into a separate host directory,
  // where link-signalk-admin.mjs resolves them and the job starts the
  // signalk-server binary, so they are never dependencies of this package.
  "ignoreDependencies": ["signalk-server", "@signalk/server-admin-ui"],
  "ignoreBinaries": ["signalk-server"]
}
