{
  "name": "signalk-openrouter-companion",
  "version": "0.7.3",
  "description": "OpenRouter-powered LLM analyzers for Signal K: plain-prose engine, battery, and weather reports. OpenRouter API key required.",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "type": "module",
  "files": [
    "dist/",
    "public/",
    "assets/icons/",
    "assets/screenshots/",
    "docs/*.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-category-utility",
    "signalk-category-notifications",
    "openrouter",
    "llm",
    "marine"
  ],
  "signalk-plugin-enabled-by-default": false,
  "signalk": {
    "displayName": "OpenRouter Companion",
    "appIcon": "./assets/icons/icon-192.png",
    "screenshots": [
      "./assets/screenshots/panel-overview.png",
      "./assets/screenshots/panel-overview-dark.png",
      "./assets/screenshots/panel-overview-night.png",
      "./assets/screenshots/panel-analyzers.png"
    ],
    "recommends": [
      "signalk-virtual-weather-sensors",
      "signalk-nmea2000-emitter-cannon"
    ]
  },
  "engines": {
    "node": ">=22.18"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=10.9.3",
      "onFail": "error"
    }
  },
  "packageManager": "npm@11.18.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Nearl Crews",
    "email": "NearlCrews@users.noreply.github.com",
    "url": "https://github.com/NearlCrews"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NearlCrews/signalk-openrouter-companion.git"
  },
  "homepage": "https://github.com/NearlCrews/signalk-openrouter-companion#readme",
  "bugs": {
    "url": "https://github.com/NearlCrews/signalk-openrouter-companion/issues"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://www.buymeacoffee.com/nearlcrews"
  },
  "peerDependencies": {
    "@signalk/server-api": ">=2.24.0 <3"
  },
  "dependencies": {
    "croner": "^10.0.1"
  },
  "overrides": {
    "markdownlint-cli2": {
      "js-yaml": "5.2.2"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "^1.62.1",
    "@signalk/server-api": "2.30.0",
    "@size-limit/file": "^13.0.3",
    "@types/node": "26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "cspell": "10.0.1",
    "css-loader": "^7.1.4",
    "dependency-cruiser": "^18.1.1",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "knip": "^6.31.0",
    "markdownlint-cli2": "0.23.2",
    "publint": "0.3.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "signalk-nearlcrews-ui": "0.6.2",
    "size-limit": "^13.0.3",
    "style-loader": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "^8.2.0",
    "vitest": "4.1.10",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2"
  },
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:bundle && npm run build:panel && npm run check:panel",
    "build:types": "tsc --emitDeclarationOnly --declaration --outDir dist",
    "build:bundle": "node esbuild.config.mjs",
    "build:panel": "node scripts/build-panel.mjs",
    "check:panel": "node scripts/check-panel-bundle.mjs",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','public'])fs.rmSync(d,{recursive:true,force:true})\"",
    "dev": "tsx watch src/index.ts",
    "check": "npm run type-check",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test --project=chromium",
    "test:browser:cross": "playwright test",
    "test:browser:with-build": "npm run build && npm run test:browser",
    "test:browser:cross:with-build": "npm run build && npm run test:browser:cross",
    "test:host-asset": "node scripts/check-signalk-admin-asset.mjs",
    "test:integration": "node scripts/check-signalk-integration.mjs",
    "type-check": "tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.panel.json && tsc -p tsconfig.tools.json",
    "lint": "npm run lint:code && npm run lint:docs && npm run spellcheck",
    "lint:code": "biome lint . && eslint . --cache --cache-location .cache/eslint",
    "lint:docs": "markdownlint-cli2 \"*.md\" \".github/*.md\" \"docs/*.md\"",
    "lint:fix": "biome lint --write . && eslint . --fix --cache --cache-location .cache/eslint",
    "spellcheck": "cspell --no-progress --show-suggestions README.md CHANGELOG.md THIRD_PARTY_NOTICES.md CLAUDE.md \".github/**/*.{md,yml,yaml}\" \"docs/*.md\"",
    "ci:biome": "biome ci .",
    "ci:workflows": "node scripts/check-workflows.mjs",
    "cruise": "depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "size": "size-limit",
    "package:check": "publint --pack npm --strict && node scripts/check-package.mjs",
    "security-audit": "npm audit --audit-level=moderate",
    "audit:runtime": "npm audit --omit=dev --audit-level=high",
    "audit:release": "npm audit --audit-level=high",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "validate": "npm run verify",
    "verify:commit": "npm run ci:biome && npm run lint && npm run ci:workflows && npm run cruise && npm run deadcode",
    "verify:fast": "npm run verify:commit && npm run check",
    "verify": "npm run verify:fast && npm run test:coverage && npm run build && npm run size",
    "verify:browser": "npm run verify && npm run test:browser",
    "verify:release": "npm run verify && npm run test:browser:cross && npm run package:check && npm run audit:runtime && npm run audit:release",
    "hooks": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "prepublishOnly": "npm run verify:release"
  },
  "size-limit": [
    {
      "name": "Plugin server bundle",
      "path": "dist/index.js",
      "limit": "60 kB"
    },
    {
      "name": "Configuration panel JavaScript",
      "path": "public/*.{js,mjs}",
      "limit": "33 kB",
      "gzip": true
    }
  ],
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
